# Local development only — docker-compose.yml reads these.
#
#   cp .env.example .env
#
# Nothing here is used by the Helm chart or the Kubernetes manifests; those
# take their credentials from a Secret. Do not reuse these values anywhere
# that is reachable by anyone but you.

MONGO_USERNAME=mongouser
MONGO_PASSWORD=localdevpassword
MONGO_DATABASE=appdb

# Host port for the wire protocol. Change it if something else already owns
# 27017 — a real MongoDB you still have running, most likely.
MONGO_PORT=27017
